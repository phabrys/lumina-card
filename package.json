{
  "name": "lumina-card",
  "version": "0.10.4",
  "description": "Carte Home Assistant pour piloter une pièce gérée par Lumina",
  "type": "module",
  "license": "MIT",
  "author": "phabrys",
  "repository": "github:phabrys/lumina-card",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test test/*.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "happy-dom": "20.14.6",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  }
}
